/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), midi=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), ambient-light-sensor=(), autoplay=(), encrypted-media=(), publickey-credentials-get=(), screen-wake-lock=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'

/src/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/src/js/*
  Cache-Control: public, max-age=0, must-revalidate
/src/styles/*
  Cache-Control: public, max-age=0, must-revalidate
